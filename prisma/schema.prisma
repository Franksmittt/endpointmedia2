// Endpoint Media — Google Ads CSV Automation Factory
// Multi-tenant PostgreSQL schema (Vercel + PgBouncer compatible)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Root tenant: an agency client whose campaigns the factory generates.
model AgencyClient {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique

  dailyBudget Float  @default(50.00)
  isActive    Boolean @default(true)
  targetArea  String
  location    String  @default("Johannesburg, Gauteng, South Africa")

  /// Campaign-level defaults for the Micro-Budget Sniper Protocol
  maxCpc             String @default("15.00")
  campaignName       String?
  finalUrl           String  @default("https://www.endpointmedia.co.za")
  language           String  @default("English")
  adSchedule         String  @default("(Monday[08:00-17:00]);(Tuesday[08:00-17:00]);(Wednesday[08:00-17:00]);(Thursday[08:00-17:00]);(Friday[08:00-17:00])")
  mobileBidModifier  String  @default("-30")
  tabletBidModifier  String  @default("-100")
  globalNegatives    String[] @default(["cheap", "free", "tutorial", "diy", "how to", "course", "jobs", "salary"])

  /// Service-to-service and external API credentials (store hashed in production)
  apiAuthKey         String?
  googleAdsCustomerId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serviceNiches  ServiceNiche[]
  campaignAssets CampaignAsset[]

  @@index([isActive])
  @@index([slug])
}

/// Commercial vertical siloed into exact-match ad groups.
model ServiceNiche {
  id         String   @id @default(uuid())
  name       String
  /// Micro-Budget Sniper: exact match only — stored for audit, enforced in factory
  matchTypes String[] @default(["exact"])
  /// Optional explicit keyword seeds; factory expands with geo templates when empty
  keywords   String[] @default([])
  sortOrder  Int      @default(0)

  clientId String
  client   AgencyClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  assets CampaignAsset[]

  @@index([clientId])
  @@unique([clientId, name])
}

enum AssetType {
  HEADLINE
  DESCRIPTION
  SITELINK
  CALLOUT
}

/// RSA headlines/descriptions and campaign-level sitelink extensions.
model CampaignAsset {
  id   String    @id @default(uuid())
  type AssetType
  text String    @db.VarChar(90)

  /// Sitelink-only fields
  descriptionLine1 String? @db.VarChar(35)
  descriptionLine2 String? @db.VarChar(35)
  finalUrl         String?

  clientId String
  client   AgencyClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  serviceNicheId String?
  serviceNiche   ServiceNiche? @relation(fields: [serviceNicheId], references: [id], onDelete: SetNull)

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([clientId, type])
  @@index([serviceNicheId])
}

/// Persisted runtime/web audit reports for SaaS lead capture and paywall unlocks.
model AuditReport {
  id              String   @id @default(cuid())
  targetUrl       String
  leadEmail       String?
  rawAuditData    Json
  blurState       Boolean  @default(true)
  stripeSessionId String?
  createdAt       DateTime @default(now())
}

/// Contact / audit form submissions — durable lead store independent of email delivery.
model ContactLead {
  id           String   @id @default(cuid())
  name         String
  email        String
  phone        String?
  message      String   @db.Text
  source       String   @default("contact-form")
  ip           String?
  userAgent    String?
  emailStatus  String   @default("pending") // pending | sent | failed | skipped
  resendId     String?
  emailError   String?
  createdAt    DateTime @default(now())

  @@index([email])
  @@index([source])
  @@index([createdAt])
  @@index([emailStatus])
}

/// Onboarding / contract package lifecycle (invite-only /onboarding flow).
enum ContractStatus {
  draft
  awaiting_signature
  signed
  awaiting_payment
  active
  suspended
}

model OnboardingSubmission {
  id             String         @id @default(cuid())
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  status         ContractStatus @default(draft)
  /// Full OnboardingFormData payload
  form           Json
  entityName     String
  signatoryEmail String
  /// unknown/below_r2m → true (CPA-protected treatment)
  cpaProtected   Boolean        @default(true)
  serviceSelection String       @default("")
  /// Opaque token for HTML preview / sign / PDF without admin secret
  previewToken   String         @unique @default(cuid())
  /// Rendered HTML snapshot used for hash + PDF (Phase 3A+)
  packageHtmlSnapshot String?   @db.Text
  emailStatus    String         @default("pending")
  emailError     String?
  /// clickwrap_fallback | pandadoc | docusign | signiflow
  signatureMode  String?
  signedAt       DateTime?
  /// Public or signed blob URL when using Vercel Blob
  pdfUrl         String?
  /// Local path or blob pathname key
  pdfStorageKey  String?

  /// Phase 4 — first invoice / payment gate
  invoiceAmountZar   Int?
  paymentReference   String?
  invoiceEmailedAt   DateTime?
  paidAt             DateTime?
  paymentMethod      String?   // eft | paystack
  paymentAmountZar   Int?
  paymentNote        String?   @db.Text
  paystackReference  String?
  suspendedAt        DateTime?
  suspendReason      String?   @db.Text
  /// Phase 5 — last payment reminder sent (idempotent throttle)
  lastReminderAt     DateTime?

  signatureAudits SignatureAuditEvent[]

  @@index([createdAt])
  @@index([status])
  @@index([signatoryEmail])
  @@index([entityName])
  @@index([paymentReference])
  @@index([paystackReference])
  @@index([lastReminderAt])
}

/// Clickwrap / e-sign audit trail (Phase 3 Option A).
model SignatureAuditEvent {
  id             String   @id @default(cuid())
  submissionId   String
  submission     OnboardingSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  signedAt       DateTime @default(now())
  ipAddress      String?
  userAgent      String?  @db.Text
  typedName      String
  documentSha256 String
  checkboxFlags  Json
  tokenUsed      String
  event          String   @default("signed") // viewed | accepted | signed | declined
  provider       String   @default("clickwrap_fallback")

  @@index([submissionId])
  @@index([signedAt])
  @@index([documentSha256])
}

/// Idempotent Paystack fulfillment records for store purchases.
model StorePayment {
  id            String   @id @default(cuid())
  reference     String   @unique
  event         String
  status        String?
  amount        Int?
  currency      String?
  productSlug   String?
  productName   String?
  customerEmail String?
  rawPayload    Json
  processedAt   DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([event])
  @@index([productSlug])
  @@index([customerEmail])
}
