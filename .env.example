NEXT_PUBLIC_BASE_URL=https://www.endpointmedia.co.za
GOOGLE_SITE_VERIFICATION=

# IndexNow (Bing, Yandex, etc.) — generate key: openssl rand -hex 16
# Verification file is served at https://www.endpointmedia.co.za/{INDEXNOW_KEY}.txt
INDEXNOW_KEY=
INDEXNOW_SECRET=
# Optional: Vercel Cron can use CRON_SECRET instead of INDEXNOW_SECRET
CRON_SECRET=

# Google Analytics & Ads (set in Vercel production env)
NEXT_PUBLIC_GA_ID=G-SGFD6DFTRV
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-17744075656

# Google Ads conversion labels — copy from Ads → Tools → Conversions → Tag setup
# Example send_to: AW-17744075656/LbRwCOqzq6ECEOmRz-gD → label is LbRwCOqzq6ECEOmRz-gD
NEXT_PUBLIC_CONVERSION_LABEL_FORM=
NEXT_PUBLIC_CONVERSION_LABEL_AUDIT=
NEXT_PUBLIC_CONVERSION_LABEL_PHONE=
NEXT_PUBLIC_CONVERSION_LABEL_WHATSAPP=

# Contact & audit form delivery (Resend)
# Use a verified domain sender in production, e.g. hello@endpointmedia.co.za
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
CONTACT_TO_EMAIL=hello@endpointmedia.co.za
# Optional: extra inboxes (comma-separated) so leads also hit your personal Gmail
CONTACT_CC_EMAIL=
CONTACT_NOTIFY_EMAILS=
# Optional: Bearer token for GET /api/contact/leads and /api/onboarding/leads
# Also authorises GET /api/onboarding/[id]/preview|pdf|handoff|health and POST .../activate
# Sign/PDF for clients use ?token=<previewToken>
CONTACT_ADMIN_SECRET=

# Optional: Vercel Blob for signed PDF storage (production recommended)
BLOB_READ_WRITE_TOKEN=
# Optional local PDF directory override (default: .data/onboarding-pdfs)
ONBOARDING_PDF_DIR=

# Future Option B (not wired):
# PANDADOC_API_KEY=

# Phase 4 — Manual EFT (primary payment path)
ONBOARDING_BANK_NAME=
ONBOARDING_BANK_ACCOUNT_NAME=
ONBOARDING_BANK_ACCOUNT_NUMBER=
ONBOARDING_BANK_BRANCH_CODE=
# Payment reference = PREFIX + last 8 of submission id (e.g. EMAB12CD34)
ONBOARDING_PAYMENT_REFERENCE_PREFIX=EM

# Phase 5 — Payment reminders (awaiting_payment; default 3 days)
ONBOARDING_PAYMENT_REMINDER_DAYS=3
# Vercel Cron Authorization: Bearer CRON_SECRET (also used by IndexNow route)
# CRON_SECRET=  (defined above with IndexNow)

# Phase 5 — Remove DRAFT package banners only after SA attorney clearance (default OFF)
# ONBOARDING_ATTORNEY_CLEARED=true


# PostgreSQL (use pooled URL on Vercel, direct URL for migrations)
DATABASE_URL=
DIRECT_URL=

# Google Ads CSV Factory — Next.js bridge → FastAPI microservice
FASTAPI_SERVICE_URL=
INTERNAL_API_KEY=
FACTORY_ADMIN_SECRET=

AUDITOR_UNLOCK_TOKEN=
AUDITOR_UNLOCK_AMOUNT_CENTS=4900
REDIS_URL=
# Optional Paystack for onboarding first invoice (hidden if either key missing)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
