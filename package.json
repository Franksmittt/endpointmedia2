{
  "name": "endpointmedia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "seo:validate": "python scripts/seo/validate_seo.py --base-url http://localhost:3000",
